includes:
    - ./vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-mockery/extension.neon

parameters:

    paths:
        - src/

    level: max

    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        - '#Trait Oltrematica\\RoleLite\\Trait\\HasRoles is used zero times and is not analysed.#'
        - '#Trait Oltrematica\\RoleLite\\Trait\\HasPermissions is used zero times and is not analysed.#'
        - '#Trait Oltrematica\\RoleLite\\Trait\\ChecksPermissions is used zero times and is not analysed.#'
        -
            message: '#should return Illuminate\\Database\\Eloquent\\Relations\\BelongsToMany<.+> but returns Illuminate\\Database\\Eloquent\\Relations\\BelongsToMany<.+>#'
            identifier: return.type
        -
            message: '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model::\$roles#'
            identifier: property.notFound

    excludePaths:
        - ./tests/ArchTest.php
        - ./tests/TestCase.php
        - ./tests/UnitTestCase.php